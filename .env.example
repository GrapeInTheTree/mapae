# ---------------------------------------------------------------------------
# GIWA Sepolia (chain 91342)
# ---------------------------------------------------------------------------
# The public endpoint is rate-limited and returns "no backend is currently
# healthy" under heavy eth_getLogs load - always retry.
GIWA_SEPOLIA_RPC_URL=https://sepolia-rpc.giwa.io

# ~200ms preconfirmations via the `pending` block tag. Optional, nicer for live demos.
GIWA_SEPOLIA_FLASHBLOCKS_RPC_URL=https://sepolia-rpc-flashblocks.giwa.io

# ---------------------------------------------------------------------------
# Keys - TWO DISTINCT KEYPAIRS. Generate each with `cast wallet new`.
# ---------------------------------------------------------------------------
# Never reuse one key for both roles: the entire point of the demo is that one
# party grants scoped authority to a DIFFERENT party. If principal == agent the
# delegation proves nothing.
#
# 1) PRINCIPAL - the human. Deploys the contracts, owns the MapaeAccount that
#    holds the funds, holds the Dojang attestation, and signs the delegation.
#    This is the only address that needs faucet funding.
PRINCIPAL_PRIVATE_KEY=

# 2) AGENT - the delegate. Submits redeemDelegations and pays gas for it.
#    Does NOT need a faucet claim; the deploy script tops it up from PRINCIPAL.
AGENT_PRIVATE_KEY=

# MERCHANT and ATTACKER are addresses only - no keys, they never send a tx.
# Defaults are deterministic; override only if you want vanity addresses.
# MERCHANT_ADDRESS=
# ATTACKER_ADDRESS=

# ---------------------------------------------------------------------------
# Funding
# ---------------------------------------------------------------------------
# Claim to the PRINCIPAL address from both (each is Cloudflare-gated, so manual):
#   https://faucet.giwa.io                     0.005 ETH / 24h
#   https://faucet.lambda256.io/giwa-sepolia   0.01  ETH / 24h
#
# Budget at gasPrice ~1,000,260 wei:
#   full contract deployment   ~0.00001 ETH
#   entire T1-T8 demo gas      <0.0001  ETH
#   Dojang attestation fee      0.001   ETH x2  (T7 revoke -> T8 re-issue)
# Total ~0.0025 ETH. A single 0.005 claim covers everything with room to retry.
