/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  # This page asks people to sign things. Anything that can be locked down should be.
  Cross-Origin-Opener-Policy: same-origin

# Vite fingerprints every asset filename, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The shell must not be, or a deploy would never reach anyone already holding a tab.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
