# GIWA Sepolia (chain 91342). Public endpoint is rate-limited and returns
# "no backend is currently healthy" under heavy eth_getLogs load - always retry.
GIWA_SEPOLIA_RPC_URL=https://sepolia-rpc.giwa.io

# ~200ms preconfirmations via the `pending` block tag. Optional; nicer for live demos.
GIWA_SEPOLIA_FLASHBLOCKS_RPC_URL=https://sepolia-rpc-flashblocks.giwa.io

# Deployer / demo keys. NEVER commit real values - .env is gitignored.
# Fund from https://faucet.giwa.io (0.005 ETH/24h) and
#           https://faucet.lambda256.io/giwa-sepolia (0.01 ETH/24h)
PRIVATE_KEY=
AGENT_PRIVATE_KEY=
